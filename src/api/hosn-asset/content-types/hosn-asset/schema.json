{
  "kind": "collectionType",
  "collectionName": "hosn_assets",
  "info": {
    "singularName": "hosn-asset",
    "pluralName": "hosn-assets",
    "displayName": "Hosn El Hal - Assets",
    "description": "Videos, audios, thumbnails (visual messages) and worksheets"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "string",
      "required": true
    },
    "description": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "text"
    },
    "format": {
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "type": "enumeration",
      "enum": [
        "video",
        "audio",
        "thumbnail",
        "worksheet"
      ],
      "required": true
    },
    "pillar": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::hosn-pillar.hosn-pillar",
      "inversedBy": "assets"
    },
    "tags": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::hosn-tag.hosn-tag",
      "inversedBy": "assets"
    },
    "order": {
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "type": "integer",
      "min": 0
    },
    "duration_minutes": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "integer",
      "min": 0
    },
    "page_count": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "integer",
      "min": 1
    },
    "cover_image": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "how_to_use": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "component",
      "repeatable": true,
      "component": "shared.usage-tip"
    },
    "video": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "component",
      "repeatable": false,
      "component": "shared.processed-video"
    },
    "audio": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "component",
      "repeatable": false,
      "component": "shared.processed-audio"
    },
    "file_web": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "file_print": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "file_mobile": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "interactive_content": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "dynamiczone",
      "components": [
        "worksheet.instruction",
        "worksheet.text-input",
        "worksheet.scale",
        "worksheet.choice",
        "worksheet.table"
      ]
    },
    "bundles": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::hosn-bundle.hosn-bundle",
      "mappedBy": "assets"
    },
    "view_count": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "biginteger"
    },
    "download_count": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "biginteger"
    }
  }
}
