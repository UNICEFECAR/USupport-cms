{
  "kind": "collectionType",
  "collectionName": "hosn_pillars",
  "info": {
    "singularName": "hosn-pillar",
    "pluralName": "hosn-pillars",
    "displayName": "Hosn El Hal - Pillars",
    "description": "The thematic pillars assets belong to"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "key": {
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "type": "string",
      "required": true,
      "regex": "^[a-z0-9-]+$"
    },
    "name": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "string",
      "required": true
    },
    "tagline": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "string"
    },
    "description": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "text"
    },
    "icon": {
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "order": {
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "type": "integer",
      "default": 0
    },
    "assets": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::hosn-asset.hosn-asset",
      "mappedBy": "pillar"
    }
  }
}
