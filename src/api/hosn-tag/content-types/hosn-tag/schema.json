{
  "kind": "collectionType",
  "collectionName": "hosn_tags",
  "info": {
    "singularName": "hosn-tag",
    "pluralName": "hosn-tags",
    "displayName": "Hosn El Hal - Tags",
    "description": "Topic, need and mood tags used for filters and recommendations"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "key": {
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "type": "string",
      "required": true,
      "regex": "^[a-z0-9-]+$"
    },
    "name": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "string",
      "required": true
    },
    "type": {
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "type": "enumeration",
      "enum": [
        "topic",
        "need",
        "mood"
      ],
      "required": true
    },
    "assets": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::hosn-asset.hosn-asset",
      "mappedBy": "tags"
    },
    "bundles": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::hosn-bundle.hosn-bundle",
      "mappedBy": "tags"
    }
  }
}
