{
  "collectionName": "components_shared_processed_audios",
  "info": {
    "displayName": "Processed audio",
    "icon": "headphone",
    "description": "Upload any audio or video file: it's converted to a small audio file, plus a light video when the upload has a picture"
  },
  "options": {},
  "attributes": {
    "source": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "audios",
        "videos"
      ]
    },
    "audio_url": {
      "type": "string"
    },
    "video_hls_url": {
      "type": "string"
    },
    "has_video": {
      "type": "boolean"
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "pending",
        "processing",
        "ready",
        "failed"
      ]
    },
    "error": {
      "type": "text"
    },
    "duration_seconds": {
      "type": "integer"
    },
    "processed_source_id": {
      "type": "integer",
      "private": true
    }
  }
}
